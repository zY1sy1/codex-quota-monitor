<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 额度球"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="112"
        Height="112"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Codex 额度球">
    <Window.Resources>
        <Style x:Key="OrbIconButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E6323A4C"
            BorderBrush="#4D707A90"
            BorderThickness="1"
            CornerRadius="56"
            Cursor="Hand">
        <Grid>
            <Border x:Name="HeaderDragArea"
                    Height="30"
                    Margin="23,0,23,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="2"
                    AutomationProperties.Name="拖动额度球" />

            <Ellipse x:Name="RingTrack"
                     Width="76"
                     Height="76"
                     Stroke="#664D566A"
                     StrokeThickness="6"
                     IsHitTestVisible="False" />
            <Path x:Name="RingValue"
                  Width="70"
                  Height="70"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stroke="#FF58C2C7"
                  StrokeThickness="6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="MetricText"
                           MaxWidth="62"
                           Foreground="#FFF4F3F1"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="剩余额度" />
                <TextBlock x:Name="ValueText"
                           MaxWidth="72"
                           Foreground="#FFF4F3F1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           AutomationProperties.Name="绝对余额" />
                <TextBlock x:Name="SourceText"
                           MaxWidth="62"
                           Margin="0,1,0,0"
                           Foreground="#FFAFB8CB"
                           FontSize="9"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="额度来源" />
            </StackPanel>

            <Button x:Name="ModeButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8,8,0,0"
                    Panel.ZIndex="3"
                    Style="{StaticResource OrbIconButton}"
                    Content="▣"
                    ToolTip="切换显示模式"
                    AutomationProperties.Name="切换显示模式" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Panel.ZIndex="3"
                    Style="{StaticResource OrbIconButton}"
                    Content="×"
                    ToolTip="关闭到系统托盘"
                    AutomationProperties.Name="关闭到系统托盘" />
        </Grid>
    </Border>
</Window>
