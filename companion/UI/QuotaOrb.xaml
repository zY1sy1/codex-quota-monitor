<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 额度球"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="84"
        Height="84"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Codex 额度球">
    <Window.Resources>
        <Style x:Key="OrbIconButton" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style x:Key="OrbHoverIconButton" TargetType="Button" BasedOn="{StaticResource OrbIconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.95" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrbIconGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E6323A4C"
            BorderThickness="0"
            CornerRadius="42"
            Cursor="Hand">
        <Grid>
            <Border x:Name="HeaderDragArea"
                    Height="30"
                    Margin="26,0,26,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="2"
                    AutomationProperties.Name="拖动额度球" />

            <Grid Width="80"
                  Height="80"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Panel.ZIndex="0">
                <!-- The track and the value arc share one geometry spec (radius 36,
                     center 40, stroke 8, ink exactly inscribed in this 80x80 cell),
                     so both render as the SAME true circle at every percentage. -->
                <Path x:Name="RingTrack"
                      Width="80"
                      Height="80"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="None"
                      Stroke="#40716D68"
                      StrokeThickness="8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />
                <Path x:Name="RingValue"
                      Width="80"
                      Height="80"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="None"
                      Stroke="#FF58C2C7"
                      StrokeThickness="8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />
            </Grid>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="MetricText"
                           MaxWidth="58"
                           Foreground="#FFF4F3F1"
                           FontSize="19"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="剩余额度" />
                <TextBlock x:Name="ValueText"
                           MaxWidth="64"
                           Foreground="#FFF4F3F1"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           AutomationProperties.Name="绝对余额" />
                <TextBlock x:Name="SourceText"
                           MaxWidth="56"
                           Margin="0,2,0,0"
                           Foreground="#FFAFB8CB"
                           FontSize="9"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="额度来源" />
            </StackPanel>

            <Button x:Name="ModeButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="2,2,0,0"
                    Panel.ZIndex="3"
                    Style="{StaticResource OrbHoverIconButton}"
                    ToolTip="切换显示模式"
                    AutomationProperties.Name="切换显示模式">
                <Path Style="{StaticResource OrbIconGlyph}" Width="9" Height="9"
                      Data="M5,2 H9.8 V7.2 M2.2,4.6 H7.6 V10 H2.2 Z" />
            </Button>
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,2,2,0"
                    Panel.ZIndex="3"
                    Style="{StaticResource OrbHoverIconButton}"
                    ToolTip="关闭到系统托盘"
                    AutomationProperties.Name="关闭到系统托盘">
                <Path Style="{StaticResource OrbIconGlyph}" Width="8" Height="8"
                      Data="M3.1,3.1 L8.9,8.9 M8.9,3.1 L3.1,8.9" />
            </Button>
        </Grid>
    </Border>
</Window>
