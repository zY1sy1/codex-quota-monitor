<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="中转站额度管理"
        Width="980"
        Height="760"
        MinWidth="800"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#FF202634"
        Foreground="#FFF4F3F1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="中转站额度管理器">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#FF323A4C" />
            <Setter Property="Foreground" Value="#FFF4F3F1" />
            <Setter Property="BorderBrush" Value="#FF596276" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#FF323A4C" />
            <Setter Property="Foreground" Value="#FFF4F3F1" />
            <Setter Property="BorderBrush" Value="#FF596276" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="5,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAFB8CB" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="EditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="中转站列表" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox x:Name="ProviderList"
                     Grid.Row="1"
                     DisplayMemberPath="DisplayName"
                     Background="#FF2A3141"
                     Foreground="#FFF4F3F1"
                     BorderBrush="#FF596276"
                     AutomationProperties.Name="中转站列表" />
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                <Button x:Name="AddButton" Content="新增" AutomationProperties.Name="新增中转站" />
                <Button x:Name="EditButton" Content="编辑" AutomationProperties.Name="编辑中转站" />
                <Button x:Name="DuplicateButton" Content="复制" AutomationProperties.Name="复制中转站" />
                <Button x:Name="DeleteButton" Content="删除" AutomationProperties.Name="删除中转站" />
            </UniformGrid>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="EnabledCheckBox"
                              Grid.ColumnSpan="3"
                              Content="启用"
                              Margin="0,0,0,10"
                              AutomationProperties.Name="启用中转站" />

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="名称" />
                        <TextBox x:Name="NameTextBox" AutomationProperties.Name="中转站名称" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="类型" />
                        <ComboBox x:Name="ProviderKindComboBox" AutomationProperties.Name="中转站类型">
                            <ComboBoxItem Content="通用配置" Tag="Generic" />
                            <ComboBoxItem Content="自定义脚本" Tag="Custom" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="基础地址" />
                        <TextBox x:Name="BaseUrlTextBox" AutomationProperties.Name="基础地址" />
                    </StackPanel>

                    <Expander x:Name="AdvancedRequestExpander"
                              Grid.Row="3"
                              Grid.ColumnSpan="3"
                              Header="高级请求"
                              IsExpanded="False"
                              Margin="0,10,0,0">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="请求方法" />
                                <ComboBox x:Name="MethodComboBox" AutomationProperties.Name="请求方法">
                                    <ComboBoxItem Content="GET" Tag="GET" />
                                    <ComboBoxItem Content="POST" Tag="POST" />
                                    <ComboBoxItem Content="PUT" Tag="PUT" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="请求路径" />
                                <TextBox x:Name="PathTextBox" AutomationProperties.Name="请求路径" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="查询参数 JSON" />
                                <TextBox x:Name="QueryTextBox" Style="{StaticResource EditorTextBox}" Height="72" AutomationProperties.Name="查询参数 JSON" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="请求头 JSON" />
                                <TextBox x:Name="HeadersTextBox" Style="{StaticResource EditorTextBox}" Height="88" AutomationProperties.Name="请求头 JSON" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="请求体（可选字符串）" />
                                <TextBox x:Name="BodyTextBox" Style="{StaticResource EditorTextBox}" Height="72" AutomationProperties.Name="请求体" />
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="提取函数" />
                        <TextBox x:Name="ExtractorScriptTextBox"
                                 Style="{StaticResource EditorTextBox}"
                                 Height="150"
                                 AutomationProperties.Name="中转站提取函数" />
                        <TextBlock x:Name="MigrationWarningText"
                                   Margin="0,6,0,0"
                                   Foreground="#FFFFC857"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="迁移提示" />
                    </StackPanel>

                    <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="API 密钥" />
                            <PasswordBox x:Name="ApiKeyPasswordBox" AutomationProperties.Name="API 密钥" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="访问令牌" />
                            <PasswordBox x:Name="AccessTokenPasswordBox" AutomationProperties.Name="访问令牌" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="用户 ID" />
                            <PasswordBox x:Name="UserIdPasswordBox" AutomationProperties.Name="用户 ID" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="超时（秒）" />
                            <TextBox x:Name="TimeoutTextBox" AutomationProperties.Name="超时秒数" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="查询间隔（分钟，0 为手动）" />
                            <TextBox x:Name="IntervalTextBox" AutomationProperties.Name="查询间隔分钟数" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TestButton" Content="测试中转站" AutomationProperties.Name="测试中转站" />
                <TextBlock x:Name="TestStateText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#FFAFB8CB"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <ListBox x:Name="PreviewList"
                     Grid.Row="2"
                     Background="#FF2A3141"
                     Foreground="#FFF4F3F1"
                     BorderBrush="#FF596276"
                     AutomationProperties.Name="脱敏测试预览" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="SaveButton" Content="保存" IsDefault="True" AutomationProperties.Name="保存中转站" />
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" AutomationProperties.Name="取消中转站更改" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
