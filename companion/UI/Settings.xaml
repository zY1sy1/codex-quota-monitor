<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420"
        SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFFFF"
        Foreground="#FF1F2329"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Codex 额度监控设置">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF1F2329" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF1F2329" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF5A6478" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF5A6478" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <GroupBox x:Name="DisplayModeGroup" Header="显示模式" Style="{StaticResource GroupBoxStyle}">
            <StackPanel Margin="8,4,0,6">
                <RadioButton x:Name="FullModeRadio" Content="完整窗口" GroupName="DisplayModeGroup" Tag="Full" />
                <RadioButton x:Name="CompactBarModeRadio" Content="迷你条" GroupName="DisplayModeGroup" Tag="CompactBar" />
                <RadioButton x:Name="OrbModeRadio" Content="额度球" GroupName="DisplayModeGroup" Tag="Orb" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="ThemeGroup" Header="主题" Style="{StaticResource GroupBoxStyle}">
            <StackPanel Margin="8,4,0,6">
                <RadioButton x:Name="LightThemeRadio" Content="浅色透明" GroupName="ThemeGroup" Tag="Light" />
                <RadioButton x:Name="DarkThemeRadio" Content="深色透明" GroupName="ThemeGroup" Tag="Dark" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="FullLayoutGroup" Header="完整窗口布局" Style="{StaticResource GroupBoxStyle}">
            <StackPanel Margin="8,4,0,6">
                <RadioButton x:Name="OverviewLayoutRadio" Content="总览折叠" GroupName="FullLayoutGroup" Tag="Overview" />
                <RadioButton x:Name="TabsLayoutRadio" Content="标签切换" GroupName="FullLayoutGroup" Tag="Tabs" />
            </StackPanel>
        </GroupBox>

        <StackPanel Margin="0,0,0,12">
            <CheckBox x:Name="TopmostCheckBox" Content="始终置顶" />
            <CheckBox x:Name="StartupCheckBox" Content="开机启动" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="立即刷新" />
            <Button x:Name="ManageRelaysButton" Content="管理中转站" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Foreground="#FF5A6478"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0" />
    </StackPanel>
</Window>
